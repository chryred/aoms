# Agent-T (ClickHouse + gateway) — 값은 운영 .env 에만 기록. 아래는 플레이스홀더.
CLICKHOUSE_PASSWORD=your_value_here
# admin-api / log-analyzer 의 ClickHouse 접속 (compose 기본값과 동일하면 생략 가능)
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=agent_t
CLICKHOUSE_USER=agent_t
# admin-api 가 gateway 실시간 SSE 를 중계할 때 사용
AGENT_T_GATEWAY_URL=http://agent-t-gateway:8330
