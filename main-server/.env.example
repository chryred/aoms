# ==============================================================================
# .env.example — 운영 환경변수 템플릿
# ==============================================================================
# 이 파일을 복사하여 .env 로 사용하세요.
#
# 표기 규칙
#   [필수] = 없으면 해당 서비스 동작 불가
#   [옵션] = 기본값 있음, 비워도 동작
#   [개발] = 로컬 개발 시 다른 값을 사용해야 하는 항목
#
# ── 로컬 개발 (.env.local) 체크리스트 ────────────────────────────────────────
#   DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5432/synapse
#   CORS_ORIGINS=http://localhost:3001,http://localhost:5173
#   FRONTEND_EXTERNAL_URL=http://localhost:3001
#   COOKIE_SECURE=false
#   OAUTH_ISSUER=http://localhost:8080
#   OAUTH_PRIVATE_KEY_PATH=<절대경로>/services/admin-api/secrets/oauth_private.pem
#   OAUTH_PUBLIC_KEY_PATH=<절대경로>/services/admin-api/secrets/oauth_public.pem
# ==============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Prometheus
# ─────────────────────────────────────────────────────────────────────────────
# configs/prometheus/web.yml 의 bcrypt 해시와 동일한 원문 비밀번호

# [필수]
PROM_USER=admin
PROM_PASS=your_prometheus_password


# ─────────────────────────────────────────────────────────────────────────────
# Grafana
# ─────────────────────────────────────────────────────────────────────────────

# [필수]
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password


# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
# docker-compose 가 DATABASE_URL 자동 조합:
#   postgresql+asyncpg://synapse:{DB_PASSWORD}@postgres:5432/synapse

# [필수]
DB_USER=synapse
DB_PASSWORD=your_db_password


# ─────────────────────────────────────────────────────────────────────────────
# admin-api
# ─────────────────────────────────────────────────────────────────────────────

# ── 인증 / 보안 ──────────────────────────────────────────────────────────────

# [필수] JWT 서명 키 — 운영 배포 시 반드시 새로 생성
#   생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_jwt_secret_key_here

# [필수] Fernet 대칭키 — DB 수집기 + 챗봇 executor 자격증명 암호화 공용
#   생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# [필수] CORS 허용 도메인 (콤마 구분)
# [개발] http://localhost:3001,http://localhost:5173
CORS_ORIGINS=http://{server-a-ip}:3001

# [옵션] JWT 유효 기간
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# [개발] false
COOKIE_SECURE=true

# ── OIDC IdP (ADR-014) ───────────────────────────────────────────────────────
# 타시스템 SSO용 RSA 키. 최초 1회 생성 후 admin-api 이미지에 번들됨.
#   cd main-server/services/admin-api/secrets
#   openssl genrsa -out oauth_private.pem 2048
#   openssl rsa -in oauth_private.pem -pubout -out oauth_public.pem
#   secrets/*.pem 은 .gitignore 처리됨 — 절대 커밋 금지

# [필수] 컨테이너 내부 고정 경로 (이미지 빌드 시 번들)
OAUTH_PRIVATE_KEY_PATH=/app/secrets/oauth_private.pem
OAUTH_PUBLIC_KEY_PATH=/app/secrets/oauth_public.pem
# [필수] OIDC issuer URL (브라우저가 접근 가능한 서버 주소)
# [개발] http://localhost:8080
OAUTH_ISSUER=http://{server-a-ip}:8080

# ── 서비스 연동 ──────────────────────────────────────────────────────────────

# [필수] Teams 카드 "해결책 등록" 버튼이 여는 React URL
#        Teams는 사용자 PC 브라우저에서 열리므로 서버 IP 필요 (localhost 불가)
# [개발] http://localhost:3001
FRONTEND_EXTERNAL_URL=http://{server-a-ip}:3001

# [옵션] synapse_agent remote-write 대상 Prometheus URL
AGENT_PROMETHEUS_URL=http://{server-a-ip}:9090

# [옵션] Teams Incoming Webhook 전역 폴백 (시스템별 webhook이 우선, 비우면 알림 건너뜀)
TEAMS_WEBHOOK_URL=your_teams_incoming_webhook_url

# [옵션] Prometheus 교차 분석 주기 (초, 기본 300)
#PROMETHEUS_ANALYZE_INTERVAL_SECONDS=300

# [옵션] DB 수집기 주기 (초, 기본 60)
#ORACLE_COLLECT_INTERVAL_SECS=60

# [옵션] 파일 저장 경로 오버라이드
#        기본값: 이미지 내 경로 → docker-compose 볼륨 마운트(./services/attaches/)로 자동 연결
#        비표준 경로 사용 시에만 아래 값을 지정
#KNOWLEDGE_DOCS_DIR=/opt/synapse/knowledge-docs
#CHAT_ATTACHMENT_DIR=/opt/synapse/chat-attachments


# ─────────────────────────────────────────────────────────────────────────────
# LLM — admin-api + log-analyzer 공용 (ADR-001)
# ─────────────────────────────────────────────────────────────────────────────
# llm_client.py Strategy: devx(운영 내부) | claude(Anthropic) | openai(OpenAI)
# ADR-012: ollama 폐지

# [필수]
LLM_TYPE=devx
LLM_API_URL=
LLM_MODEL=

# [필수] DevX OAuth client_credentials 인증
#        agent_code는 DB llm_agent_configs 에서 업무 영역별 관리
DEVX_CLIENT_ID=your_devx_client_id
DEVX_CLIENT_SECRET=your_devx_client_secret


# ─────────────────────────────────────────────────────────────────────────────
# log-analyzer
# ─────────────────────────────────────────────────────────────────────────────

# [필수] Qdrant 벡터 DB (Server B, ADR-011)
QDRANT_URL=http://{server-b-ip}:6333

# [옵션] 로그 분석 주기 (초, 기본 300)
#ANALYSIS_INTERVAL_SECONDS=300

# [옵션] 임베딩 모델 (기본값 그대로면 설정 불필요, 변경 시에만 지정)
# DENSE_EMBED_MODEL=BAAI/bge-m3
# SPARSE_EMBED_MODEL=Qdrant/bm25

# ── V1 Knowledge — Jira / Confluence 동기화 ──────────────────────────────────
# 미사용 시 빈 값으로 두면 스케줄러 자동 비활성화
# 동기화 스케줄: 매일 04:00 KST (Jira) / 04:30 KST (Confluence)
JIRA_URL=https://jira.company.com
JIRA_TOKEN=your_jira_personal_access_token
JIRA_PROJECTS=PROJ1,PROJ2
CONFLUENCE_URL=https://confluence.company.com
CONFLUENCE_TOKEN=your_confluence_personal_access_token
CONFLUENCE_SPACES=SPACE1,SPACE2
# [옵션] 동기화 초당 API 호출 수 상한 (기본 5)
#KNOWLEDGE_SYNC_RATE_LIMIT=5


# ─────────────────────────────────────────────────────────────────────────────
# n8n (워크플로우 자동화, 예비 컨테이너 — 현재 미사용)
# ─────────────────────────────────────────────────────────────────────────────
N8N_USER=synapse
N8N_PASSWORD=your_n8n_password
# 외부에서 n8n webhook 접근 시 사용하는 Server A IP
MONITORING_SERVER_IP={server-a-ip}
